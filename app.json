{
  "expo": {
    "name": "Gaznger",
    "slug": "gaznger",
    "owner": "btom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gaznger",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gaznger.app",
      "icon": "./assets/images/adaptive-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Gaznger needs your location to match you with nearby stations, route riders to your address, and show you live delivery tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Riders use background location while on an active delivery so customers can see live ETA. Location is never tracked outside of an order.",
        "NSCameraUsageDescription": "Gaznger needs camera access so you can upload verification documents (ID, licence, plate photos).",
        "NSPhotoLibraryUsageDescription": "Gaznger needs photo library access so you can pick verification documents from your existing photos.",
        "NSFaceIDUsageDescription": "Gaznger uses Face ID to unlock the app and authorise sensitive actions like withdrawals."
      }
    },
    "android": {
      "package": "com.gaznger.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {}
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "config": {
        "firebase": {
          "apiKey": "AIzaSyBwdmwm9ktICVHndB-WTxPHAD_-MF4E4LA",
          "authDomain": "gaznger-3rms.firebaseapp.com",
          "projectId": "gaznger-3rms",
          "storageBucket": "gaznger-3rms.firebasestorage.app",
          "messagingSenderId": "1021816796284",
          "appId": "1:1021816796284:web:2926d92c25bc24746c05f9",
          "measurementId": "G-Z4J914J3XB"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68bb341e-e53b-4345-8b4d-5dd5f4c6ca52"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/68bb341e-e53b-4345-8b4d-5dd5f4c6ca52",
      "enabled": false,
      "checkAutomatically": "NEVER"
    }
  }
}
